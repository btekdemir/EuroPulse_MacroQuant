    {
      "name": "European gas price spike",
      "components": [
        "ELC_GAS"
      ],
      "countries": [],
      "size_pct": 20.0,
      "profile": {
        "kind": "ramp",
        "half_life_months": null,
        "months": 6,
        "fractions": null
      },
      "start": "2026-11",
      "second_round": false,
      "second_round_regime": "post2020",
      "rationale": "Wholesale gas (TTF) spikes. Retail gas and electricity follow slowly and partially because of regulated tariffs, fixed-term contracts and price caps, so the shock ramps in over 6 months. Size +20% on the retail level, about a quarter of the 2021\u201322 episode, when euro area electricity, gas and heat prices rose 75% from Jun 2021 to their peak (Eurostat).",
      "sources": [
        "Eurostat prc_hicp_minr ELC_GAS 2021-2022",
        "ECB Economic Bulletin boxes on retail energy pass-through"
      ],
      "mapping": "Judgemental: retail ELC_GAS +20% over 6 months (no TTF series in the pipeline)"
    },
    {
      "name": "France regulated electricity tariff +10%",
      "components": [
        "ELC_GAS"
      ],
      "countries": [
        "FR"
      ],
      "size_pct": 6.241,
      "profile": {
        "kind": "permanent",
        "half_life_months": null,
        "months": null,
        "fractions": null
      },
      "start": "2027-02",
      "second_round": false,
      "second_round_regime": "post2020",
      "rationale": "Illustrative +10% change in France's regulated electricity tariff (TRVE), which is typically revised on 1 February. Electricity is 62.4% of France's ELC_GAS weight in 2026 (Eurostat CP0451 / ELC_GAS), so ELC_GAS in France rises 6.24%. Assumes the change applies to all households.",
      "sources": [
        "Eurostat prc_hicp_iw FR CP0451, ELC_GAS",
        "Eurostat prc_hicp_cw (FR country weight)"
      ],
      "mapping": "FR ELC_GAS level = 10% \u00d7 electricity share 0.624"
    }
