      "start": "2026-11",
      "second_round": false,
      "second_round_regime": "post2020",
      "rationale": "A supply disruption (e.g. Strait of Hormuz) lifts Brent in EUR by 30% and it stays there. Fuel consumer prices respond with the estimated elasticity 0.31 (HAC s.e. 0.04, 2005-03\u20132026-09): +8.4% on the fuel price level, 66% of it in the first month. Elasticity < 1 because excise duty is per litre.",
      "sources": [
        "FRED DCOILBRENTEU",
        "ECB EXR USD/EUR",
        "Eurostat prc_hicp_minr FUEL",
        "hicp/passthrough.py"
      ],
      "mapping": "FUEL level = (1.30)^0.307 \u2212 1, lag profile from the estimated distributed lag"
