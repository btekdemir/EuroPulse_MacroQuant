{
  "$defs": {
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "pattern": "^V\\d+$",
          "title": "Gate",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "critical": {
          "description": "A failed critical gate stops the forecast step",
          "title": "Critical",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "details": {
          "description": "Flagged rows, capped",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "gate",
        "name",
        "status",
        "critical",
        "message"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "Status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_at": {
      "format": "date-time",
      "title": "Run At",
      "type": "string"
    },
    "last_period": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Last Period",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    }
  },
  "required": [
    "run_at",
    "last_period",
    "gates"
  ],
  "title": "ValidationReport",
  "type": "object"
}
