{
  "$defs": {
    "Leg": {
      "additionalProperties": false,
      "description": "One shock: the same price-level change for a set of components in a set of countries.",
      "properties": {
        "components": {
          "items": {
            "enum": [
              "FUEL",
              "ELC_GAS",
              "FOOD_P",
              "FOOD_NP",
              "IGD_NNRG",
              "SERV"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "countries": {
          "description": "empty = euro area-wide",
          "items": {
            "enum": [
              "AT",
              "BE",
              "BG",
              "CY",
              "DE",
              "EE",
              "EL",
              "ES",
              "FI",
              "FR",
              "HR",
              "IE",
              "IT",
              "LT",
              "LU",
              "LV",
              "MT",
              "NL",
              "PT",
              "SI",
              "SK"
            ],
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "size_pct": {
          "description": "shock to the consumer price LEVEL, %",
          "exclusiveMaximum": 200,
          "exclusiveMinimum": -50,
          "title": "Size Pct",
          "type": "number"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "start": {
          "pattern": "^\\d{4}-\\d{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "components",
        "size_pct",
        "profile",
        "start"
      ],
      "title": "Leg",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "description": "How the price-level shock evolves after the start month (fraction of the full size).",
      "properties": {
        "kind": {
          "enum": [
            "permanent",
            "decaying",
            "temporary",
            "ramp",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "half_life_months": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "decaying only",
          "title": "Half Life Months"
        },
        "months": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "temporary: duration; ramp: months to full size",
          "title": "Months"
        },
        "fractions": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "custom: fraction per month, last value held",
          "title": "Fractions"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Profile",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "description": "One or more legs, run together. Legs that hit the same (country, component) cell combine\nmultiplicatively on the price level (their log deviations add); nothing is overwritten.",
      "properties": {
        "name": {
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/Leg"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Legs",
          "type": "array"
        },
        "second_round": {
          "default": false,
          "title": "Second Round",
          "type": "boolean"
        },
        "second_round_regime": {
          "default": "post2020",
          "enum": [
            "post2020",
            "pre2020"
          ],
          "title": "Second Round Regime",
          "type": "string"
        },
        "rationale": {
          "description": "Mandatory: why these sizes, profiles and mappings",
          "minLength": 40,
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "mapping": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How an external shock maps to the HICP component",
          "title": "Mapping"
        }
      },
      "required": [
        "name",
        "legs",
        "rationale",
        "sources"
      ],
      "title": "Scenario",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the in-browser simulator needs. The JS engine mirrors hicp.shocks.simulate.",
  "properties": {
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "months": {
      "items": {
        "type": "string"
      },
      "title": "Months",
      "type": "array"
    },
    "components": {
      "items": {
        "type": "string"
      },
      "title": "Components",
      "type": "array"
    },
    "countries": {
      "items": {
        "type": "string"
      },
      "title": "Countries",
      "type": "array"
    },
    "weight_matrix": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "description": "country -> component -> share of EA headline",
      "title": "Weight Matrix",
      "type": "object"
    },
    "ea_effective_weights": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Ea Effective Weights",
      "type": "object"
    },
    "baseline_yoy": {
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Baseline Yoy",
      "type": "array"
    },
    "growth_factor": {
      "description": "1 + baseline YoY/100 used to scale the YoY impact",
      "items": {
        "type": "number"
      },
      "title": "Growth Factor",
      "type": "array"
    },
    "core_share": {
      "title": "Core Share",
      "type": "number"
    },
    "energy_components": {
      "items": {
        "type": "string"
      },
      "title": "Energy Components",
      "type": "array"
    },
    "second_round": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Second Round",
      "type": "object"
    },
    "fuel_brent_elasticity": {
      "additionalProperties": true,
      "title": "Fuel Brent Elasticity",
      "type": "object"
    },
    "break_test": {
      "additionalProperties": true,
      "description": "Chow, sup-Wald and sub-sample tests of the energy->core regime",
      "title": "Break Test",
      "type": "object"
    },
    "aggregation_check_max_abs": {
      "description": "max |\u03a3_c W_c,i \u2212 EA w_eff_i|",
      "title": "Aggregation Check Max Abs",
      "type": "number"
    },
    "presets": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "title": "Presets",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "origin",
    "months",
    "components",
    "countries",
    "weight_matrix",
    "ea_effective_weights",
    "baseline_yoy",
    "growth_factor",
    "core_share",
    "energy_components",
    "second_round",
    "fuel_brent_elasticity",
    "break_test",
    "aggregation_check_max_abs",
    "presets",
    "assumptions"
  ],
  "title": "ShockBasis",
  "type": "object"
}
