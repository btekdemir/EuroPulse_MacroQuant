{
  "$defs": {
    "Leg": {
      "additionalProperties": false,
      "description": "One shock: the same price-level change for a set of components in a set of countries.",
      "properties": {
        "components": {
          "items": {
            "enum": [
              "FUEL",
              "ELC_GAS",
              "FOOD_P",
              "FOOD_NP",
              "IGD_NNRG",
              "SERV"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "countries": {
          "description": "empty = euro area-wide",
          "items": {
            "enum": [
              "AT",
              "BE",
              "BG",
              "CY",
              "DE",
              "EE",
              "EL",
              "ES",
              "FI",
              "FR",
              "HR",
              "IE",
              "IT",
              "LT",
              "LU",
              "LV",
              "MT",
              "NL",
              "PT",
              "SI",
              "SK"
            ],
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "size_pct": {
          "description": "shock to the consumer price LEVEL, %",
          "exclusiveMaximum": 200,
          "exclusiveMinimum": -50,
          "title": "Size Pct",
          "type": "number"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "start": {
          "pattern": "^\\d{4}-\\d{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "components",
        "size_pct",
        "profile",
        "start"
      ],
      "title": "Leg",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "description": "How the price-level shock evolves after the start month (fraction of the full size).",
      "properties": {
        "kind": {
          "enum": [
            "permanent",
            "decaying",
            "temporary",
            "ramp",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "half_life_months": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "decaying only",
          "title": "Half Life Months"
        },
        "months": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "temporary: duration; ramp: months to full size",
          "title": "Months"
        },
        "fractions": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "custom: fraction per month, last value held",
          "title": "Fractions"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Profile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One or more legs, run together. Legs that hit the same (country, component) cell combine\nmultiplicatively on the price level (their log deviations add); nothing is overwritten.",
  "properties": {
    "name": {
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "legs": {
      "items": {
        "$ref": "#/$defs/Leg"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Legs",
      "type": "array"
    },
    "second_round": {
      "default": false,
      "title": "Second Round",
      "type": "boolean"
    },
    "second_round_regime": {
      "default": "post2020",
      "enum": [
        "post2020",
        "pre2020"
      ],
      "title": "Second Round Regime",
      "type": "string"
    },
    "rationale": {
      "description": "Mandatory: why these sizes, profiles and mappings",
      "minLength": 40,
      "title": "Rationale",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "mapping": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How an external shock maps to the HICP component",
      "title": "Mapping"
    }
  },
  "required": [
    "name",
    "legs",
    "rationale",
    "sources"
  ],
  "title": "Scenario",
  "type": "object"
}
