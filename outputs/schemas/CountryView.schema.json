{
  "$defs": {
    "CountryProfile": {
      "additionalProperties": false,
      "description": "One country's own drivers: exact chain-linked contributions of the six components to its y/y.",
      "properties": {
        "contributions": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "description": "component -> pp per month in CountryView.dates",
          "title": "Contributions",
          "type": "object"
        },
        "max_abs_gap_pp": {
          "description": "max |\u03a3 contributions \u2212 published y/y| over the window",
          "title": "Max Abs Gap Pp",
          "type": "number"
        },
        "index": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "headline index (2025=100) by month, last 8 years",
          "title": "Index",
          "type": "object"
        }
      },
      "required": [
        "contributions",
        "max_abs_gap_pp",
        "index"
      ],
      "title": "CountryProfile",
      "type": "object"
    }
  },
