{
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/scenario.py": {
      "maxDuration": 30
    },
    "api/ask.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
